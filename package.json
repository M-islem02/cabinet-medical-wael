{
  "name": "medcareso",
  "version": "2.1.1",
  "description": "MedCareSO - Application de gestion de cabinet de Médecine Physique et Fonctionnelle",
  "author": "MedCareSO Team",
  "main": "src/main/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "npx @electron/rebuild",
    "build": "electron-builder",
    "build-win": "electron-builder --win --x64 && npm run rebuild",
    "build-linux": "electron-builder --linux",
    "build-mac": "electron-builder --mac"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "moment": "^2.29.4",
    "mysql2": "^3.16.0",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.4.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.medcareso.app",
    "productName": "MedCareSO",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/assets/",
        "to": "assets/"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "MedCareSO-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "better-sqlite3@11.10.0": true,
    "electron@28.3.3": true,
    "lzma-native@8.0.6": true
  }
}
